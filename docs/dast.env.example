# JAAL — Agentic DAST environment template
#
# The DAST module reuses the existing Convex/Auth configuration.
# It does NOT require a separate database or any security-scanner credential.

# Client: provided by the Freebuff/Convex environment.
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Convex CLI/deployment: provided by the managed environment.
CONVEX_DEPLOYMENT=dev:your-deployment

# Existing Convex Auth variables (already configured; do not commit values).
# JWKS=
# JWT_PRIVATE_KEY=
# SITE_URL=

# Optional: existing Groq features. The deterministic DAST planner does not need it.
# GROQ_API_KEY=

# The synthetic lab is in-process. There is deliberately no target URL secret here:
# external targets cannot be registered by this demonstration.
